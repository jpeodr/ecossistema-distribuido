# =============================================================================
# AgroData Distribuído — Variáveis de Ambiente (.env.example)
# =============================================================================
# Copie este arquivo para a raiz do projeto antes de rodar o Docker Compose:
#   cp .env.example .env
# =============================================================================

COMPOSE_PROJECT_NAME=agrodata

# -----------------------------------------------------------------------------
# MySQL — Credenciais e Usuários
# -----------------------------------------------------------------------------
MYSQL_ROOT_PASSWORD=rootpass
MYSQL_DATABASE=agrodata
MYSQL_USER=agro
MYSQL_PASSWORD=agropass

# Usuário de replicação GTID (Master -> Slaves)
MYSQL_REPL_USER=repl
MYSQL_REPL_PASSWORD=replpass

# Nomes dos Hosts e Porta Interna na Rede Docker
MYSQL_MASTER_HOST=mysql_master
MYSQL_SLAVE1_HOST=mysql_slave1
MYSQL_SLAVE2_HOST=mysql_slave2
MYSQL_SLAVE3_HOST=mysql_slave3
MYSQL_PORT=3306

# Portas Mapeadas no Host Local (Máquina Física)
MYSQL_MASTER_PORT=3310
MYSQL_SLAVE1_PORT=3307
MYSQL_SLAVE2_PORT=3308
MYSQL_SLAVE3_PORT=3309

# -----------------------------------------------------------------------------
# RabbitMQ — Mensageria
# -----------------------------------------------------------------------------
RABBITMQ_HOST=rabbitmq
RABBITMQ_DEFAULT_USER=guest
RABBITMQ_DEFAULT_PASS=guest
RABBITMQ_PORT=5672
RABBITMQ_MGMT_PORT=15672

# -----------------------------------------------------------------------------
# Manager — Nó Coordenador (FastAPI)
# -----------------------------------------------------------------------------
MANAGER_PORT=8000

# -----------------------------------------------------------------------------
# Workers — Processamento Paralelo
# -----------------------------------------------------------------------------
# Quantidade de threads por worker para consulta simultânea de produtos
WORKER_THREADS=4
# Tentativas de processamento por tarefa antes de enviar para a fila de erros (DLQ)
WORKER_MAX_TENTATIVAS=2
# Segundos de espera antes de devolver uma tarefa que falhou para a fila
WORKER_RETRY_DELAY=2

# -----------------------------------------------------------------------------
# Coleta IBGE / SIDRA — Tabela 6588 (LSPA)
# -----------------------------------------------------------------------------
SIDRA_TABELA=6588
SIDRA_PRODUTOS=soja,milho,arroz,feijao,trigo,cafe
SIDRA_PERIODOS=2023,2024,2025
# Resiliência das consultas do worker à API do SIDRA (o IBGE usa Cloudflare,
# que às vezes desafia rajadas de requisições com HTTP 403 transitório)
SIDRA_TENTATIVAS=4
SIDRA_BACKOFF=3.0