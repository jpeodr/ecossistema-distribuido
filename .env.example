# =============================================================================
# AgroData Distribuído — variáveis de ambiente (exemplo)
#
# Copie para .env e ajuste conforme necessário:
#     cp .env.example .env
# O arquivo .env NÃO deve ser versionado (já está no .gitignore).
# =============================================================================

COMPOSE_PROJECT_NAME=agrodata

# -----------------------------------------------------------------------------
# MySQL — credenciais
# -----------------------------------------------------------------------------
MYSQL_ROOT_PASSWORD=rootpass
MYSQL_DATABASE=agrodata
MYSQL_USER=agro
MYSQL_PASSWORD=agropass

# Usuário usado na replicação master -> slaves
MYSQL_REPL_USER=repl
MYSQL_REPL_PASSWORD=replpass

# -----------------------------------------------------------------------------
# MySQL — portas no host (a porta interna dos containers é sempre 3306)
# -----------------------------------------------------------------------------
MYSQL_MASTER_PORT=3310
MYSQL_SLAVE1_PORT=3307
MYSQL_SLAVE2_PORT=3308
MYSQL_SLAVE3_PORT=3309

# -----------------------------------------------------------------------------
# RabbitMQ
# -----------------------------------------------------------------------------
RABBITMQ_DEFAULT_USER=guest
RABBITMQ_DEFAULT_PASS=guest
RABBITMQ_PORT=5672
RABBITMQ_MGMT_PORT=15672

# -----------------------------------------------------------------------------
# Manager (API/painel)
# -----------------------------------------------------------------------------
MANAGER_PORT=8000

# -----------------------------------------------------------------------------
# Workers
# -----------------------------------------------------------------------------
# Threads usadas por worker para processar produtos em paralelo
WORKER_THREADS=4

# -----------------------------------------------------------------------------
# Coleta SIDRA/IBGE — LSPA (tabela 6588)
# -----------------------------------------------------------------------------
SIDRA_TABELA=6588
# Produtos a coletar (separados por vírgula)
SIDRA_PRODUTOS=soja,milho,arroz,feijao,trigo,cafe
# Períodos (anos) a coletar (separados por vírgula)
SIDRA_PERIODOS=2023,2024,2025
